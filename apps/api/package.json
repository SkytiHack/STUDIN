{
  "name": "@dteu-schedule/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "worker": "ts-node src/worker.ts",
    "start": "npx prisma db push --accept-data-loss && node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "npx prisma generate && cd ../../packages/mia-parser && npm run build && cd ../../apps/api && tsc -b"
  },
  "dependencies": {
    "@dteu-schedule/mia-parser": "^1.0.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/node-cron": "^3.0.11"
  }
}
