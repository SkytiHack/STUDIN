{
  "name": "dteu-schedule-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "postinstall": "cd apps/api && npx prisma generate",
    "start:api": "npm run start --workspace=@dteu-schedule/api",
    "start:worker": "npm run start:worker --workspace=@dteu-schedule/api",
    "start:bot": "npm run start --workspace=bot",
    "start:web": "npm run start --workspace=web"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
